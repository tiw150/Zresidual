Package: Zresidual
Type: Package
Title: Z-Residual: Computing and Diagnosing Gaussian-Like Residuals
Version: 0.2.0
Authors@R: c(person(given = "Tingxuan", family = "Wu", role = c("aut","cre"),
                    email = "tiw150@mail.usask.ca"),
